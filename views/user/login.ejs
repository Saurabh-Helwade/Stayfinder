<% layout("/layouts/boilerplate") %>

<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
      <div class="card login-card">

        <!-- Header -->
        <div class="card-header text-center">
          <h3 class="mb-0">Login to StayFinder</h3>
        </div>

        <!-- Body -->
        <div class="card-body">
          <form action="/login" method="POST" class="needs-validation" novalidate>

            <!-- Username -->
            <div class="mb-3">
              <label for="username" class="form-label">Username</label>
              <input
                type="text"
                id="username"
                name="username"
                class="form-control"
                required
              >
              <div class="invalid-feedback">Please enter your username.</div>
            </div>

            <!-- Password -->
            <div class="mb-3">
              <label for="password" class="form-label">Password</label>
              <input
                type="password"
                id="password"
                name="password"
                class="form-control"
                required
              >
              <div class="invalid-feedback">Please enter your password.</div>
            </div>

            <!-- Button -->
            <div class="d-grid mt-4">
              <button class="btn btn-primary">Login</button>
            </div>

          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ================= STYLES ================= -->
<style>
/* Card */
.login-card {
  border-radius: 16px;
  border: none;
  overflow: hidden;
  box-shadow: 0 15px 40px rgba(0,0,0,0.12);
}

/* Header */
.login-card .card-header {
  background: linear-gradient(135deg, var(--primary-color, #fe424d), #ff7a84);
  color: white;
  padding: 1.5rem;
}

/* Labels */
.form-label {
  font-weight: 600;
}

/* Button */
.btn-primary {
  background: linear-gradient(135deg, var(--primary-color, #fe424d), #ff7a84);
  border: none;
  padding: 0.7rem;
  font-weight: 600;
}

.btn-primary:hover {
  background: linear-gradient(135deg, #e53943, #ff4d4d);
  box-shadow: 0 4px 14px rgba(254,66,77,0.4);
}

/* ============ DARK MODE ============ */

.night-mode .login-card {
  background: #020617;
  border: 1px solid #1e293b;
  box-shadow: 0 20px 50px rgba(0,0,0,0.7);
}

.night-mode .login-card .card-body,
.night-mode .form-label {
  color: #f9fafb;
}

.night-mode .form-control {
  background-color: #020617;
  color: #f9fafb;
  border-color: #1e293b;
}

.night-mode .form-control::placeholder {
  color: #94a3b8;
}

.night-mode .form-control:focus {
  background-color: #020617;
  color: #ffffff;
  border-color: var(--primary-color, #fe424d);
  box-shadow: 0 0 0 0.2rem rgba(254,66,77,0.25);
}
</style>
