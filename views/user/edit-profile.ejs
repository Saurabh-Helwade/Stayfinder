<% layout("/layouts/boilerplate") %>

<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card profile-card">

        <!-- Header -->
        <div class="card-header">
          <h3 class="mb-0">Edit Profile</h3>
        </div>

        <!-- Body -->
        <div class="card-body">
          <form method="POST" action="/profile/edit" enctype="multipart/form-data">

            <!-- Avatar -->
            <div class="text-center mb-4">
              <label for="avatar" class="profile-avatar-wrapper">

                <% if (user.avatar && user.avatar.url) { %>
                  <img
                    src="<%= user.avatar.url %>"
                    id="avatarPreview"
                    class="profile-avatar-img"
                  />
                <% } else { %>
                  <i class="fa-regular fa-user-circle fa-6x profile-avatar-icon"></i>
                <% } %>

                <div class="edit-overlay">
                  <i class="fa-solid fa-camera"></i>
                </div>

              </label>

              <input
                type="file"
                id="avatar"
                name="avatar"
                class="d-none"
                accept="image/*"
                onchange="previewAvatar(event)"
              />
            </div>

            <!-- Username -->
            <div class="mb-3">
              <label class="form-label">Username</label>
              <input
                type="text"
                class="form-control"
                name="username"
                value="<%= user.username %>"
                required
              />
            </div>

            <!-- Email -->
            <div class="mb-3">
              <label class="form-label">Email</label>
              <input
                type="email"
                class="form-control"
                name="email"
                value="<%= user.email %>"
                required
              />
            </div>

            <!-- Phone -->
            <div class="mb-3">
              <label class="form-label">Phone</label>
              <input
                type="tel"
                class="form-control"
                name="phone"
                value="<%= user.phone || '' %>"
              />
            </div>

            <!-- Bio -->
            <div class="mb-3">
              <label class="form-label">Bio</label>
              <textarea
                class="form-control"
                rows="3"
                name="bio"
                placeholder="Tell us about yourself"
              ><%= user.bio || '' %></textarea>
            </div>

            <!-- Buttons -->
            <div class="d-flex justify-content-end gap-2">
              <a href="/profile" class="btn btn-outline-secondary">Cancel</a>
              <button class="btn btn-primary">Save Changes</button>
            </div>

          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ================= STYLES ================= -->
<style>
.profile-card {
  border-radius: 16px;
  overflow: hidden;
  border: none;
  box-shadow: 0 15px 40px rgba(0,0,0,0.12);
}

.profile-card .card-header {
  background: linear-gradient(135deg, var(--primary-color), #ff7a84);
  color: white;
  padding: 1.5rem;
}

.profile-avatar-wrapper {
  position: relative;
  display: inline-block;
  cursor: pointer;
}

.profile-avatar-img {
  width: 140px;
  height: 140px;
  border-radius: 50%;
  object-fit: cover;
  border: 4px solid var(--primary-color);
}

.profile-avatar-icon {
  color: var(--primary-color);
}

.edit-overlay {
  position: absolute;
  bottom: 10px;
  right: 10px;
  width: 34px;
  height: 34px;
  background: var(--primary-color);
  border-radius: 50%;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
}

.form-label {
  font-weight: 600;
}

.btn-primary {
  background: linear-gradient(135deg, var(--primary-color), #ff7a84);
  border: none;
  padding: 0.7rem 1.5rem;
  font-weight: 600;
}

.btn-primary:hover {
  background: linear-gradient(135deg, #e53943, #ff4d4d);
  box-shadow: 0 4px 14px rgba(254,66,77,0.4);
}

/* ============ DARK MODE ============ */

.night-mode .profile-card {
  background: #020617;
  border: 1px solid #1e293b;
  box-shadow: 0 20px 50px rgba(0,0,0,0.7);
}

.night-mode .form-label,
.night-mode .card-body {
  color: #f9fafb;
}

.night-mode .form-control {
  background: #020617;
  color: #f9fafb;
  border-color: #1e293b;
}

.night-mode .form-control::placeholder {
  color: #94a3b8;
}

.night-mode .btn-outline-secondary {
  color: #e5e7eb;
  border-color: #334155;
}

.night-mode .btn-outline-secondary:hover {
  background: rgba(254,66,77,0.15);
  color: white;
}
</style>

<!-- ================= SCRIPT ================= -->
<script>
function previewAvatar(event) {
  const reader = new FileReader();
  reader.onload = function () {
    let img = document.getElementById("avatarPreview");
    if (!img) {
      img = document.createElement("img");
      img.id = "avatarPreview";
      img.className = "profile-avatar-img";
      document.querySelector(".profile-avatar-wrapper").innerHTML = "";
      document.querySelector(".profile-avatar-wrapper").appendChild(img);
    }
    img.src = reader.result;
  };
  reader.readAsDataURL(event.target.files[0]);
}
</script>
