<% layout("/layouts/boilerplate") %>

<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
      <div class="card signup-card">

        <!-- Header -->
        <div class="card-header text-center">
          <h3 class="mb-0">Sign Up for StayFinder</h3>
        </div>

        <!-- Body -->
        <div class="card-body">

          <form action="/signup" method="POST" novalidate class="needs-validation">

            <!-- Username -->
            <div class="mb-3">
              <label for="username" class="form-label">Username</label>
              <input
                type="text"
                id="username"
                name="username"
                class="form-control"
                required
              >
              <div class="invalid-feedback">Please enter a username.</div>
            </div>

            <!-- Email -->
            <div class="mb-3">
              <label for="email" class="form-label">Email</label>
              <input
                type="email"
                id="email"
                name="email"
                class="form-control"
                required
              >
              <div class="invalid-feedback">Please enter a valid email.</div>
            </div>

            <!-- Password -->
            <div class="mb-3">
              <label for="password" class="form-label">Password</label>
              <input
                type="password"
                id="password"
                name="password"
                class="form-control"
                required
              >
              <div class="invalid-feedback">Please enter a password.</div>
            </div>

            <!-- Submit -->
            <button class="btn btn-primary w-100 mt-3">
              Sign Up
            </button>
          </form>

          <!-- Divider -->
          <div class="divider my-4">
            <span class="divider-text">or</span>
          </div>

          <!-- Google Signup -->
          <div class="social-login">
            <a href="/auth/google" class="btn btn-google w-100">
              <i class="fab fa-google me-2"></i>
              Sign Up with Google
            </a>
          </div>

          <!-- Login Redirect -->
          <div class="text-center mt-4">
            <p class="mb-0">
              Already have an account?
              <a href="/login">Login</a>
            </p>
          </div>

        </div>
      </div>
    </div>
  </div>
</div>

<!-- ================= STYLES ================= -->
<style>
/* Card */
.signup-card {
  border-radius: 16px;
  border: none;
  overflow: hidden;
  box-shadow: 0 15px 40px rgba(0,0,0,0.12);
}

/* Header */
.signup-card .card-header {
  background: linear-gradient(135deg, var(--primary-color, #fe424d), #ff7a84);
  color: white;
  padding: 1.5rem;
}

/* Labels */
.form-label {
  font-weight: 600;
}

/* Divider */
.divider {
  display: flex;
  align-items: center;
  text-align: center;
}

.divider::before,
.divider::after {
  content: "";
  flex: 1;
  border-bottom: 1px solid #dee2e6;
}

.divider-text {
  padding: 0 10px;
  color: #6c757d;
  font-size: 0.9rem;
}

/* Primary button */
.btn-primary {
  background: linear-gradient(135deg, var(--primary-color, #fe424d), #ff7a84);
  border: none;
  font-weight: 600;
  padding: 0.7rem;
}

.btn-primary:hover {
  background: linear-gradient(135deg, #e53943, #ff4d4d);
  box-shadow: 0 4px 14px rgba(254,66,77,0.4);
}

/* Google button */
.btn-google {
  background-color: #fff;
  border: 1px solid #ddd;
  color: #555;
  transition: all 0.3s ease;
}

.btn-google:hover {
  background-color: #f8f9fa;
  border-color: #ccc;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
}

.btn-google i {
  color: #DB4437;
}

/* ============ DARK MODE ============ */

.night-mode .signup-card {
  background: #020617;
  border: 1px solid #1e293b;
  box-shadow: 0 20px 50px rgba(0,0,0,0.7);
}

.night-mode .signup-card .card-body,
.night-mode .form-label,
.night-mode p {
  color: #f9fafb;
}

.night-mode .form-control {
  background-color: #020617;
  color: #f9fafb;
  border-color: #1e293b;
}

.night-mode .form-control::placeholder {
  color: #94a3b8;
}

.night-mode .form-control:focus {
  background-color: #020617;
  color: #ffffff;
  border-color: var(--primary-color, #fe424d);
  box-shadow: 0 0 0 0.2rem rgba(254,66,77,0.25);
}

.night-mode .divider::before,
.night-mode .divider::after {
  border-color: #1e293b;
}

.night-mode .divider-text {
  color: #94a3b8;
}

.night-mode .btn-google {
  background-color: #020617;
  border-color: #1e293b;
  color: #e5e7eb;
}

.night-mode .btn-google:hover {
  background-color: rgba(254,66,77,0.15);
  color: #ffffff;
}
</style>
