<% layout("/layouts/boilerplate") %>

<div class="container mt-4 mb-5">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
      <div class="form-container p-4 shadow-sm rounded bg-white">
        <h3 class="text-center mb-4">Edit Listing</h3>

        <form
          method="POST"
          action="/listings/<%= listing._id %>?_method=PUT"
          novalidate
          class="needs-validation"
          enctype="multipart/form-data"
        >
          <!-- TITLE -->
          <div class="mb-3">
            <label for="title" class="form-label">Title</label>
            <input
              type="text"
              id="title"
              name="listing[title]"
              value="<%= listing.title %>"
              class="form-control"
              required
            >
            <div class="invalid-feedback">Title should be valid.</div>
          </div>

          <!-- DESCRIPTION -->
          <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <textarea
              id="description"
              class="form-control"
              name="listing[description]"
              rows="3"
              required
            ><%= listing.description %></textarea>
            <div class="invalid-feedback">Description should be valid.</div>
          </div>

          <!-- ORIGINAL IMAGE -->
          <div class="mb-3">
            <p class="fw-semibold mb-2">Current Listing Image</p>
            <img
              src="<%= originalImageUrl %>"
              alt="Original Listing Image"
              class="img-fluid rounded"
              style="max-height: 200px;"
            >
          </div>

          <!-- NEW IMAGE -->
          <div class="mb-3">
            <label for="image" class="form-label">Upload New Image (optional)</label>
            <input
              type="file"
              id="image"
              name="listing[image]"
              class="form-control"
            >
          </div>

          <!-- PRICE + COUNTRY -->
          <div class="row">
            <div class="col-md-4 mb-3">
              <label for="price" class="form-label">Price</label>
              <input
                type="number"
                id="price"
                name="listing[price]"
                value="<%= listing.price %>"
                class="form-control"
                required
              >
              <div class="invalid-feedback">Price should be valid.</div>
            </div>

            <div class="col-md-8 mb-3">
              <label for="country" class="form-label">Country</label>
              <input
                type="text"
                id="country"
                name="listing[country]"
                value="<%= listing.country %>"
                class="form-control"
                required
              >
              <div class="invalid-feedback">Country should be valid.</div>
            </div>
          </div>

          <!-- LOCATION -->
          <div class="mb-3">
            <label for="location" class="form-label">Location</label>
            <input
              type="text"
              id="location"
              name="listing[location]"
              value="<%= listing.location %>"
              class="form-control"
              required
            >
            <div class="invalid-feedback">Location should be valid.</div>
          </div>

          <!-- SUBMIT -->
          <button class="btn btn-primary w-100 mt-3">
            Update Listing
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<style>
/* ================= DARK MODE ================= */

.night-mode .form-container {
  background-color: #020617 !important;
  border: 1px solid #1e293b;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.6);
}

.night-mode h3 {
  color: #f9fafb;
}

.night-mode .form-label,
.night-mode p {
  color: #e5e7eb;
}

.night-mode .form-control {
  background-color: #020617;
  color: #f9fafb;
  border: 1px solid #1e293b;
}

.night-mode .form-control::placeholder {
  color: #94a3b8;
}

.night-mode .form-control:focus {
  background-color: #020617;
  color: #ffffff;
  border-color: var(--primary-color, #fe424d);
  box-shadow: 0 0 0 0.2rem rgba(254, 66, 77, 0.25);
}

.night-mode input[type="file"] {
  background-color: #020617;
  color: #e5e7eb;
}

.night-mode .invalid-feedback {
  color: #fca5a5;
}

.night-mode .btn-primary {
  background: linear-gradient(135deg, var(--primary-color, #fe424d), #ff7a84);
  border: none;
}

.night-mode .btn-primary:hover {
  background: linear-gradient(135deg, #e53943, #ff4d4d);
  box-shadow: 0 6px 20px rgba(254, 66, 77, 0.35);
}
</style>
