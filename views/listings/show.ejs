<% layout("/layouts/boilerplate") %>

<style>
  /* ================= EXISTING STYLES ================= */

  .show-img {
    height: 60vh;
    object-fit: cover;
    width: 100%;
    border-radius: var(--border-radius-medium);
    box-shadow: var(--shadow-large);
  }

  .font-title {
    font-size: 2rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
    color: var(--secondary-color);
  }

  .listing-meta {
    color: #6c757d;
  }

  .booking-card {
    position: sticky;
    top: 2rem;
    border-radius: var(--border-radius-medium);
    box-shadow: var(--shadow-medium);
    padding: 1.5rem;
    background: #fff;
  }

  .review-card {
    border-radius: var(--border-radius-small);
    box-shadow: var(--shadow-small);
    border: none;
  }

  /* ================= DARK MODE FIX ================= */

  .night-mode .font-title {
    color: #f9fafb;
  }

  .night-mode .listing-meta {
    color: #cbd5e1;
  }

  .night-mode .listing-card,
  .night-mode .review-card,
  .night-mode .booking-card {
    background-color: #020617;
    border: 1px solid #1e293b;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.7);
  }

  .night-mode .card-body,
  .night-mode .booking-card {
    color: #e5e7eb;
  }

  .night-mode .text-muted {
    color: #94a3b8 !important;
  }

  .night-mode h3,
  .night-mode h4,
  .night-mode h5,
  .night-mode h6 {
    color: #f9fafb;
  }

  .night-mode textarea,
  .night-mode input,
  .night-mode select {
    background-color: #020617;
    color: #f9fafb;
    border-color: #1e293b;
  }

  .night-mode textarea::placeholder {
    color: #94a3b8;
  }

  .night-mode .review-card p {
    color: #e5e7eb;
  }

  .night-mode hr {
    border-color: #1e293b;
  }

  /* Buttons */
  .night-mode .btn-outline-danger {
    color: #f87171;
    border-color: #f87171;
  }

  .night-mode .btn-outline-danger:hover {
    background-color: #f87171;
    color: #020617;
  }
</style>

<div class="container mt-4">

  <!-- Title -->
  <div class="row">
    <div class="col-12">
      <h1 class="font-title"><%= listing.title %></h1>
      <p class="listing-meta">
        <%= listing.location %>, <%= listing.country %>
      </p>
    </div>
  </div>

  <!-- Image + Details -->
  <div class="row mt-3">
    <div class="col-lg-8">
      <div class="card listing-card">
        <img src="<%= listing.image.url %>" class="show-img" alt="listing-image">

        <div class="card-body">
          <h5>
            Hosted by 
            <%= listing.owner ? listing.owner.username : "Unknown Host" %>
          </h5>

          <p class="mt-3"><%= listing.description %></p>

          <h4 class="mt-3">
            ₹<%= listing.price.toLocaleString("en-IN") %>
            <small class="text-muted">/ night</small>
          </h4>
        </div>
      </div>

      <% if (currUser && listing.owner && listing.owner._id.equals(currUser._id)) { %>
        <div class="mt-3 d-flex gap-2">
          <a href="/listings/<%= listing._id %>/edit" class="btn add-btn">
            <i class="fa fa-edit"></i> Edit
          </a>

          <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
            <button class="btn btn-dark" onclick="return confirm('Delete this listing?')">
              <i class="fa fa-trash"></i> Delete
            </button>
          </form>
        </div>
      <% } %>
    </div>

    <!-- Booking Card -->
    <div class="col-lg-4">
      <div class="booking-card">
        <h4>
          ₹<%= listing.price.toLocaleString("en-IN") %>
          <small class="text-muted">/ night</small>
        </h4>

        <form method="POST" action="/listings/<%= listing._id %>/book" class="mt-3">
          <div class="mb-3">
            <label class="form-label">Check-in</label>
            <input type="date" class="form-control" name="checkin" required>
          </div>

          <div class="mb-3">
            <label class="form-label">Check-out</label>
            <input type="date" class="form-control" name="checkout" required>
          </div>

          <div class="mb-3">
            <label class="form-label">Guests</label>
            <select class="form-control" name="guests">
              <option>1</option>
              <option>2</option>
              <option>3</option>
              <option>4</option>
              <option>5+</option>
            </select>
          </div>

          <% if (currUser) { %>
            <button class="btn add-btn w-100">
              <i class="fa fa-calendar-check"></i> Book Now
            </button>
          <% } else { %>
            <a href="/login" class="btn add-btn w-100">Login to Book</a>
          <% } %>
        </form>
      </div>
    </div>
  </div>

  <!-- Reviews -->
  <div class="row mt-5">
    <div class="col-12">
      <hr>

      <% if (currUser) { %>
        <h3>Leave a Review</h3>

        <form method="POST" action="/listings/<%= listing._id %>/reviews" class="mt-3">
          <fieldset class="starability-slot mb-3">
            <input type="radio" id="rate5" name="review[rating]" value="5">
            <label for="rate5">5 stars</label>

            <input type="radio" id="rate4" name="review[rating]" value="4">
            <label for="rate4">4 stars</label>

            <input type="radio" id="rate3" name="review[rating]" value="3">
            <label for="rate3">3 stars</label>

            <input type="radio" id="rate2" name="review[rating]" value="2">
            <label for="rate2">2 stars</label>

            <input type="radio" id="rate1" name="review[rating]" value="1" checked>
            <label for="rate1">1 star</label>
          </fieldset>

          <textarea
            name="review[comment]"
            class="form-control mb-3"
            rows="4"
            placeholder="Write your experience..."
            required
          ></textarea>

          <button class="btn add-btn">Submit Review</button>
        </form>
      <% } else { %>
        <p class="text-muted">Login to leave a review.</p>
      <% } %>

      <hr class="mt-4">

      <% if (listing.reviews.length > 0) { %>
        <h3>All Reviews</h3>

        <div class="row mt-3">
          <% for (let review of listing.reviews) { %>
            <div class="col-md-6 mb-3">
              <div class="card review-card">
                <div class="card-body">
                  <h6>@<%= review.author.username %></h6>

                  <p class="starability-result" data-rating="<%= review.rating %>"></p>

                  <p><%= review.comment %></p>

                  <% if (currUser && review.author._id.equals(currUser._id)) { %>
                    <form method="POST"
                      action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                      <button class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                  <% } %>
                </div>
              </div>
            </div>
          <% } %>
        </div>
      <% } else { %>
        <p class="text-muted">No reviews yet.</p>
      <% } %>
    </div>
  </div>

</div>
