<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>StayFinder – Find Your Perfect Stay</title>

    <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png">

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@200..800&display=swap" rel="stylesheet">

    <!-- Star Rating -->
    <link rel="stylesheet" href="https://unpkg.com/starability@2.4.0/starability-slot.min.css">
    <link rel="stylesheet" href="https://unpkg.com/starability@2.4.0/starability-result.min.css">

    <!-- Main CSS -->
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/rating.css">

    <!-- Theme System -->
    <style>
        /* ========== LIGHT MODE ========== */
        :root {
            --bg-main: #f7f7f7;
            --bg-card: #ffffff;
            --bg-navbar: rgba(255,255,255,0.95);
            --bg-input: #ffffff;

            --text-main: #1f2937;
            --text-muted: #6b7280;
            --text-heading: #111827;
            --text-card: #1f2937;

            --border-color: #e5e7eb;
            --primary-color: #fe424d;

            --shadow-sm: 0 2px 6px rgba(0,0,0,0.05);
            --shadow-md: 0 6px 20px rgba(0,0,0,0.08);
        }

        body {
            font-family: "Plus Jakarta Sans", sans-serif;
            background-color: var(--bg-main);
            color: var(--text-main);
            transition: all 0.35s ease;
        }

        .navbar {
            background: var(--bg-navbar) !important;
            box-shadow: var(--shadow-sm);
        }

        .card,
        .listing-card {
            background-color: var(--bg-card);
            border: 1px solid var(--border-color);
            box-shadow: var(--shadow-sm);
        }

        .card-body {
            color: var(--text-card);
        }

        h1, h2, h3, h4, h5 {
            color: var(--text-heading);
        }

        .text-muted {
            color: var(--text-muted) !important;
        }

        /* ========== DARK MODE ========== */
        .night-mode {
            --bg-main: #0f172a;
            --bg-card: #111827;
            --bg-navbar: rgba(17, 24, 39, 0.95);
            --bg-input: #1f2937;

            --text-main: #e5e7eb;
            --text-muted: #9ca3af;
            --text-heading: #ffffff;
            --text-card: #ffffff;

            --border-color: #374151;

            --shadow-sm: 0 6px 20px rgba(0,0,0,0.6);
            --shadow-md: 0 12px 35px rgba(0,0,0,0.75);
        }

        .night-mode body {
            background-color: var(--bg-main);
            color: var(--text-main);
        }

        .night-mode .card,
        .night-mode .listing-card {
            background-color: var(--bg-card);
            border-color: var(--border-color);
            box-shadow: var(--shadow-md);
        }

        /* 🔥 FIX: FORCE CARD CONTENT VISIBILITY */
        .night-mode .card-body,
        .night-mode .card-body *,
        .night-mode .listing-card *,
        .night-mode .card-text,
        .night-mode .card-text-title,
        .night-mode .tax-info {
            color: var(--text-card) !important;
        }

        .night-mode .text-muted {
            color: var(--text-muted) !important;
        }

        main.container {
            padding-top: 2rem;
        }
    </style>
</head>

<body>
    <%- include("../includes/navbar.ejs") %>

    <main class="container">
        <%- include("../includes/flash.ejs") %>
        <%- body %>
    </main>

    <%- include("../includes/footer.ejs") %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/script.js"></script>

    <!-- Dark Mode Toggle -->
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const toggle = document.getElementById("theme-toggle");
            if (!toggle) return;

            const icon = toggle.querySelector("i");
            const body = document.body;

            if (localStorage.getItem("theme") === "dark") {
                body.classList.add("night-mode");
                icon.classList.replace("fa-moon", "fa-sun");
            }

            toggle.addEventListener("click", () => {
                body.classList.toggle("night-mode");
                const isDark = body.classList.contains("night-mode");
                icon.classList.toggle("fa-sun", isDark);
                icon.classList.toggle("fa-moon", !isDark);
                localStorage.setItem("theme", isDark ? "dark" : "light");
            });
        });
    </script>
</body>
</html>
